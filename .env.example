# Telegram bot token from @BotFather. Required.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Comma-separated Telegram user IDs that bootstrap administrator access.
# At least one is needed: the first admin cannot be promoted by an admin who
# does not yet exist. Get your ID from @userinfobot.
ADMIN_TELEGRAM_IDS=111111111,222222222

# SQLAlchemy database URL. Defaults to a local SQLite file.
DATABASE_URL=sqlite:///payroll.db

# ISO currency code used for new payroll batches.
PAYROLL_CURRENCY=USD

# When true, the matcher refuses to route between people with no shared payment
# method instead of routing anyway and flagging it for admin review.
STRICT_PAYMENT_METHODS=false

# Log every SQL statement. Noisy; debugging only.
ECHO_SQL=false
